# Production settings for /opt/ghostpass/.env (mode 600, owner ghostpass).
# NODE_ENV=production is set by the systemd units, not here.

# zwatch: viewing-key watcher, loopback only.
ZWATCH_PORT=8787
ZWATCH_DATA_DIR=.local/zwatch
ZCASH_DEVTOOL=.local/bin/zcash-devtool
ZWATCH_SERVER=zecrocks
# openssl rand -hex 32
ZWATCH_API_TOKEN=
ZWATCH_SYNC_INTERVAL_MS=20000
ZWATCH_MAX_SNAPSHOT_AGE_MS=120000
ZWATCH_URL=http://127.0.0.1:8787

# Printed by `pnpm import:viewing-key`.
MERCHANT_ACCOUNT_ID=
# The merchant's shielded Unified Address (the "address" in dr-winner's .local/merchant-account.json).
MERCHANT_UA=

# Issuer key-encryption key: openssl rand -hex 32. Back it up with the databases.
GP_KEK_HEX=
# Browsers check issuer keys against this public file.
GP_KEYS_URL=https://raw.githubusercontent.com/big14way/Ghostpass/main/KEYS.json
# The services may only write under .local/; copy this file into the repository to publish it.
GP_KEYS_LOG=.local/KEYS.json
# Dashboard password, 16+ characters: openssl rand -base64 18
GP_ADMIN_PASSWORD=

GP_HOST=127.0.0.1
NEWSLETTER_PORT=3000
API_DEMO_PORT=3001
DASHBOARD_PORT=3002
GP_DEV_FAKE_PAYMENTS=0
