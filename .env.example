# Real watcher settings; start:watcher loads .env from the project root.
ZWATCH_PORT=8787
ZWATCH_DATA_DIR=.local/zwatch
ZCASH_DEVTOOL=.local/bin/zcash-devtool
ZWATCH_SERVER=zecrocks
# Generate a local token, e.g. openssl rand -hex 32. Never commit it.
ZWATCH_API_TOKEN=
ZWATCH_SYNC_INTERVAL_MS=20000
ZWATCH_MAX_SNAPSHOT_AGE_MS=120000

# Matcher integration (the merchant accountId is returned by POST /accounts).
ZWATCH_URL=http://127.0.0.1:8787
MERCHANT_ACCOUNT_ID=
